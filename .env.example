# Copy this file to .env and change the values for your own setup.
# Nothing here is tied to Enrique's Robinhood account.

DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# Starting ticker and display name.
DASHBOARD_DEFAULT_SYMBOL=SPY
DASHBOARD_DEFAULT_NAME=SPDR S&P 500 ETF

# Option scanner profile. $80 means max premium around $0.80 for 1 contract.
DASHBOARD_OPTION_BUDGET=80
DASHBOARD_OPTION_TARGET_PREMIUM=1.07

# Top strip format: LABEL:SYMBOL,LABEL:SYMBOL
# Robinhood public quotes are used for ETFs/stocks. Yahoo is used for symbols like ^VIX.
DASHBOARD_MARKET_STRIP=SPY:SPY,QQQ:QQQ,IWM:IWM,DIA:DIA,VIX:^VIX
DASHBOARD_MAG7_STRIP=AAPL:AAPL,MSFT:MSFT,NVDA:NVDA,AMZN:AMZN,META:META,GOOGL:GOOGL,TSLA:TSLA

# Optional production referral links. Use semicolon between links.
# Example: DASHBOARD_REFERRAL_LINKS=Robinhood|https://example.com/robinhood;Chase|https://example.com/chase;Charles Schwab|https://example.com/schwab
DASHBOARD_REFERRAL_LINKS=

# Local quote history. This file is ignored by Git.
DASHBOARD_HISTORY_FILE=robinhood-history.json
DASHBOARD_HISTORY_LIMIT=50000
